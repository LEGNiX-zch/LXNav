<?xml version="1.0" encoding="utf-8"?>
<!--
  主布局（阶段三）：
  - 左上角：菜单按钮（打开抽屉）
  - 右上角：设置按钮
  - 顶部居中：灵动岛胶囊
  - 中部：LEGNIX 空白主页文字标识
  - 堆叠卡片多任务面板（覆盖层，默认隐藏）
  - 左侧抽屉工具栏（覆盖层，默认隐藏）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- LEGNIX 文字标识（空白主页） -->
    <TextView
        android:id="@+id/legnixLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/legnix"
        android:textSize="40sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="@color/glass_text"
        android:includeFontPadding="false" />

    <!-- 灵动岛胶囊 -->
    <com.legnix.lxnav.view.DynamicIslandView
        android:id="@+id/dynamicIsland"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/capsule_height"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:minWidth="100dp" />

    <!-- 左上角菜单按钮 -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_menu"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null" />

    <!-- 右上角设置按钮 -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_settings"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null" />

    <!-- 左侧抽屉工具栏（默认隐藏） -->
    <com.legnix.lxnav.view.ToolbarDrawerView
        android:id="@+id/toolbarDrawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 堆叠卡片多任务面板（默认隐藏） -->
    <com.legnix.lxnav.view.TabStackPanel
        android:id="@+id/tabStackPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
