<?xml version="1.0" encoding="utf-8"?>
<!-- 关于页：品牌简介 + 联系方式 + 持续迭代说明 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 品牌 Logo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/logo_legnix"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="LXNAV"
            android:textColor="@color/glass_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="版本 0.1.0"
            android:textColor="@color/island_text"
            android:textSize="12sp" />

        <!-- 简介 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="简介"
            android:textColor="@color/glass_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="LXNAV 是一款为小屏设备打造的轻量浏览器。灵动岛胶囊、液态玻璃主题、堆叠卡片多任务，在极小的屏幕上也能流畅上网。"
            android:textColor="@color/island_text"
            android:textSize="13sp" />

        <!-- 联系方式 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="联系方式"
            android:textColor="@color/glass_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGithub"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="GitHub：LEGNiX-zch/LXNav"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnQq"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="QQ：1479350744"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnWechat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="微信：zch20111015"
            android:textSize="12sp" />

        <!-- 迭代说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="本项目将持续迭代，欢迎反馈建议与 Bug。"
            android:textColor="@color/island_text"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
