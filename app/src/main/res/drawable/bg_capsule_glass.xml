<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃胶囊背景：圆角矩形 + 纵向半透明渐变 + 细描边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/capsule_corner" />
    <gradient
        android:startColor="@color/glass_start"
        android:endColor="@color/glass_end"
        android:angle="270" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
