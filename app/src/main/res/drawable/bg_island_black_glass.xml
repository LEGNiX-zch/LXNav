<?xml version="1.0" encoding="utf-8"?>
<!--
  需求 4：灵动岛・黑色液态玻璃
  - 亮/暗底色均为黑色主体（不透明黑底已由 View 用 GradientDrawable 绘制，
    此 drawable 提供「半透明 + 细边框 + 内发光」的液态玻璃叠加层）。
  - 结构：圆角矩形 + 轻微纵向黑色渐变（#F2~#E6，保留黑色主体）+ 亮色细边（模拟玻璃高光）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内发光 / 玻璃高光描边（外层 1dp 半透明白边） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/capsule_corner" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
    <!-- 黑色主体：半透明黑色渐变，保持黑色基调又有玻璃通透感 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/capsule_corner" />
            <gradient
                android:startColor="#E6000000"
                android:endColor="#B3000000"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
